services:
  soprano:
    build: .
    image: soprano:local
    container_name: soprano
    restart: unless-stopped
    environment:
      - PORT=8005
      # If you run a modified copy, point this at your own source (AGPL):
      # - SOURCE_URL=https://example.org/your/soprano
    ports:
      - "127.0.0.1:8005:8005"
